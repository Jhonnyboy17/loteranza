# ---------------------------------------------------------------------------
# Jackpot USA - variaveis de ambiente (frontend / Vite)
# Copie para .env.local e preencha. NUNCA commite .env.local.
# Apenas chaves publicas (anon/publishable) podem ficar no frontend.
# ---------------------------------------------------------------------------

# Supabase (opcional em modo demo: sem estas variaveis a app roda com o
# provider de dados DEMO em memoria/localStorage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Kill switch global de transacoes -------------------------------------
# Deve permanecer false ate que exista autorizacao juridica formal.
# Mesmo com true, cada jurisdicao ainda precisa ser habilitada no painel
# admin (jurisdiction_rules.transactions_enabled) E o Compliance Engine
# precisa retornar APPROVED.
VITE_TRANSACTIONS_ENABLED=false

# Marca (permite renomear a plataforma sem alterar codigo)
VITE_BRAND_NAME=Jackpot USA
VITE_BRAND_LEGAL_ENTITY=
VITE_SUPPORT_EMAIL=suporte@exemplo.com

# Fonte de cotacao cambial exibida na interface (informativo).
VITE_FX_SOURCE_LABEL=Cotacao demonstrativa

# ---------------------------------------------------------------------------
# Variaveis abaixo NAO vao para o frontend. Configure como secrets das
# Edge Functions (supabase secrets set ...). Listadas aqui como referencia.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# LOTTERY_DATA_PROVIDER=demo            # demo | <provedor licenciado>
# LOTTERY_DATA_API_KEY=
# LOTTERY_DATA_BASE_URL=
# FX_PROVIDER_API_KEY=
# KYC_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_API_KEY=
